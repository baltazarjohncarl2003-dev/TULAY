# Copy to .env.local. Never commit real values. Sandbox/test keys only outside production.

# App
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Supabase (local values come from `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Payments: "fake" (local stand-in, default) until the permit; "paymongo" later (test keys only outside production)
PAYMENT_PROVIDER=fake
# Signs the fake gateway's webhooks. Any random string of 32+ characters, local only.
FAKE_PAYMENT_WEBHOOK_SECRET=

# Courier: "fake" (local stand-in, default) until the permit; "ninjavan" later
COURIER_PROVIDER=fake
# Signs the fake courier's tracking webhooks. Any random string of 32+ characters, local only.
FAKE_COURIER_WEBHOOK_SECRET=

# PayMongo (Stage 4, test keys only)
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Ninja Van Plugin API (Stage 5)
NINJAVAN_CLIENT_ID=
NINJAVAN_CLIENT_SECRET=

# Email (Resend). Deferred: local auth emails go to Mailpit, http://127.0.0.1:54424
RESEND_API_KEY=
EMAIL_FROM=

# Google sign-in: deferred until the business permit is approved (not yet in supabase/config.toml)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Sentry (Stage 6)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
