# Copy to .env.local. Never commit real values. Sandbox/test keys only outside production.

# App
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Supabase (local values come from `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Payments: "fake" (local stand-in, default) until the permit; "paymongo" later (test keys only outside production)
PAYMENT_PROVIDER=fake
# Signs the fake gateway's webhooks. Any random string of 32+ characters, local only.
FAKE_PAYMENT_WEBHOOK_SECRET=

# Courier: "fake" (local stand-in, default) until the permit; "lalamove" or "ninjavan" later
COURIER_PROVIDER=fake
# Signs the fake courier's tracking webhooks. Any random string of 32+ characters, local only.
FAKE_COURIER_WEBHOOK_SECRET=

# PayMongo (Stage 4, test keys only)
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Ninja Van: TULAY's own shipper account (sandbox only until the audit passes).
# NINJAVAN_MOCK=1 uses an in-memory Ninja Van locally (with COURIER_PROVIDER=ninjavan); never in production.
NINJAVAN_MOCK=
# API base includes the country code: sandbox https://api-sandbox.ninjavan.co/sg (docs: all sandbox requests use /sg), production https://api.ninjavan.co/ph
NINJAVAN_API_BASE=
# Client ID and Client Key from Ninja Dashboard, Settings > IT Settings (API access is enabled by the account manager).
# The Client Key also verifies tracking webhooks.
NINJAVAN_CLIENT_ID=
NINJAVAN_CLIENT_SECRET=

# Lalamove: TULAY's own account (COURIER_PROVIDER=lalamove). Keys come from Partner Portal > Developers (sandbox keys start pk_test / sk_test).
# Sandbox base https://rest.sandbox.lalamove.com, production https://rest.lalamove.com (no /v3).
LALAMOVE_API_BASE=https://rest.sandbox.lalamove.com
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_MARKET=PH
# URL path of our shipping webhook (signed into every Lalamove webhook); must match the URL set in the Partner Portal.
LALAMOVE_WEBHOOK_PATH=/api/webhooks/shipping
# LALAMOVE_MOCK=1 uses an in-memory Lalamove, local only; refused when VERCEL_ENV=production.
# It signs its webhooks with FAKE_COURIER_WEBHOOK_SECRET (32+ characters), so set that too.
LALAMOVE_MOCK=

# TULAY AI (Gemini) reads /search requests. Server-only: never prefix with NEXT_PUBLIC_. Empty = rule-based fallback.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite; set when Google retires that model.
GEMINI_MODEL=

# Email (Resend). Deferred: local auth emails go to Mailpit, http://127.0.0.1:54424
RESEND_API_KEY=
EMAIL_FROM=

# Google sign-in: deferred until the business permit is approved (not yet in supabase/config.toml)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Sentry (Stage 6)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
